                <mxCell id="167" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;class XnbAsset : Asset&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — represents a shader or font asset stored as a &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Stream&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;+ &lt;u&gt;AssetType&lt;/u&gt; { Font, Shader } : enum&lt;br&gt;&lt;br&gt;~ &lt;b&gt;XnbAsset&lt;/b&gt;(&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;identifier: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;, name : &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, stream: &lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Stream&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, type: &lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AssetType&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;XnbAsset&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Type&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AssetType&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&