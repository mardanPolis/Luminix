                <mxCell id="56" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;Message Passing Interface&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#E6E6E6;fontFamily=Helvetica;" parent="1" vertex="1">
