                <mxCell id="171" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;record struct Region&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — immutable value type describing a single named sub-image within an AtlasAsset, defined by its bounding rectangle inside the parent atlas.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;~ Region(&lt;font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;identifier: &lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 204); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, name : &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;, &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;rectangle:&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt; Rectangle&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;) : &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Region&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;i style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Name&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: get &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;br style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;i style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Identifier&lt;/i&gt;&lt;font sty