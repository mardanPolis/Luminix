                </mxCell>
                <mxCell id="549" value="&lt;div&gt;&lt;b&gt;&lt;u&gt;+ sealed class Method&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;Description —&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Properties —&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ get Info: &lt;font color=&quot;#0000cc&quot;&gt;MethodInfo&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ get Parameters: &lt;font color=&quot;#0000cc&quot;&gt;ParameterInfo[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get elementTypes: &lt;font color=&quot;#0000cc&quot;&gt;Type[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get elementParamTypes: &lt;font color=&quot;#0000cc&quot;&gt;ParamType[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get elementAccesses: &lt;font color=&quot;#0000cc&quot;&gt;Expression[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get instanceConst: &lt;font color=&quot;#0000cc&quot;&gt;ConstantExpression&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get indexParam: &lt;font color=&quot;#0000cc&quot;&gt;ParameterExpression&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- get boundContainers: &lt;font color=&quot;#0000cc&quot;&gt;IStructContainer[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;Method&lt;/b&gt;(info: &lt;font color=&quot;#0000cc&quot;&gt;MethodInfo&lt;/font&gt;, entitySystem: &lt;font color=&quot;#0000cc&quot;&gt;EntitySystem&lt;/font&gt;, structContainer:&lt;font color=&quot;#0000cc&quot;&gt;&amp;nbsp;IStructContainer[]&lt;/font&gt;,&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;isByInOnly&lt;/span&gt;&lt;font face=&quot;Consolas&quot;&gt;: &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Method&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- compiledAction: &lt;font color=&quot;#0000cc&quot;&gt;Action&amp;lt;int&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;+ &lt;/span&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas;&quot;&gt;Invoke&lt;/b&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;(index: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;int&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;)&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(63, 63, 63);&quot;&gt;+ &lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(63, 63, 63);&quot;&gt;Invoke&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(63, 63, 63);&quot;&gt;(indexes: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;Dictionary&amp;lt;ID, int&amp;gt;.ValueCollection&lt;/font&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(63, 63, 63);&quot;&gt;)&lt;br&gt;&lt;/span&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;InvokeFor&lt;/b&gt;(length: &lt;font color=&quot;#0000cc&quot;&gt;int&lt;/font&gt;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;+ &lt;/span&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas;&quot;&gt;InvokeBackFor&lt;/b&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;(length: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;int&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="1620" width="680" height="580" as="geometry"/>
                </mxCell>
                <mxCell id="550" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;EntitySystem class methods&lt;br&gt;&lt;/h1&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;void Start(ref &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Struct&lt;/font&gt; param, ...)&lt;br&gt;void Update(ref &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Struct&lt;/font&gt; param, ...)&lt;br&gt;void Render(in &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Struct&lt;/font&gt; param, ...)&lt;br&gt;void OnDestroy(in &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Struct&lt;/font&gt; param, ...)&lt;br&gt;void Tick()&lt;br&gt;&lt;br&gt;&lt;b&gt;Parameters:&lt;/b&gt;&lt;br&gt;Must always be passed via &quot;in&quot; or &quot;ref&quot; parameter modifier.&lt;br&gt;&lt;br&gt;&lt;b&gt;Unique Parameters:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;• ID&lt;/font&gt;: represents the Entity ID. Is passed via &quot;in&quot; parameter modifier, because it is immutable.&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;• bool&lt;/font&gt;: represents the Entity active state. Is passed via &quot;in&quot; or &quot;ref&quot; parameter modifiers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tick method call order&lt;/b&gt;&lt;br&gt;&lt;br&gt;OnDestroy -&amp;gt; Start -&amp;gt; Update -&amp;gt; Render&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2800" y="1070" width="340" height="530" as="geometry"/>
                </mxCell>
                <mxCell id="553" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Method class methods&lt;br&gt;&lt;/h1&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;• Invoke(index): Invokes the method on a single target entity specified by its index.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;• Invoke(indexes):&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Invokes the specified method across multiple target entities identified by their indexes.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;• InvokeFor(length): Invokes the method sequentially across a specified range of entities, starting from the beginning up to the given length.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;• InvokeBackFor(length):&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Invokes the method sequentially across a specified range of entities, starting from the end and moving backward for the given length.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2800" y="1620" width="340" height="580" as="geometry"/>
                </mxCell>
                <mxCell id="583" value="" style="edgeStyle=none;html=1;" edge="1" parent="1" source="573" target="538">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="573" value="Tick EntitySystems" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1100" width="120" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
