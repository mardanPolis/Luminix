                <mxCell id="373" value="&lt;div&gt;&lt;b&gt;&lt;u&gt;sealed class Assets : Workspace.Service&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Description — &lt;font color=&quot;#0000cc&quot;&gt;Asset&lt;/font&gt; class stores resolved &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt; entries, grouped by extension and identified by their relative paths. Xnb and data assets are loaded into typed assets immediately upon handling, rather than deferred. This class handles unloaded assets following the engine&#39;s expected loading pattern.&lt;br&gt;• Xnb assets are loaded instantly because their concrete type (shader vs. font) can only be determined by loading them.&lt;br&gt;• Data assets are loaded instantly because they aren&#39;t identified by relative path and so that they don&#39;t overwrite one another.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Properties —&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- assetIO: &lt;font color=&quot;#0000cc&quot;&gt;AssetIO&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- assetBridge: &lt;font color=&quot;#0000cc&quot;&gt;AssetBridge&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- resourceBridge: &lt;font color=&quot;#0000cc&quot;&gt;ResourceBridge&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- atlasMaker: &lt;font color=&quot;#0000cc&quot;&gt;AtlasMaker&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- textureAssetInfos: &lt;font color=&quot;#0000cc&quot;&gt;SortedDictionary&amp;lt;string, AssetIO.AssetInfo&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- audioAssetInfos: &lt;font color=&quot;#0000cc&quot;&gt;Dictionary&amp;lt;string, AssetIO.AssetInfo&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- shaderAssets: &lt;font color=&quot;#0000cc&quot;&gt;Dictionary&amp;lt;string, XnbAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- fontAssets: &lt;font color=&quot;#0000cc&quot;&gt;Dictionary&amp;lt;string, XnbAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- unresolvedDataAssets: &lt;font color=&quot;#0000cc&quot;&gt;List&amp;lt;DataAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- dataAssets: &lt;font color=&quot;#0000cc&quot;&gt;List&amp;lt;DataAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- dataHandlers: &lt;font color=&quot;#0000cc&quot;&gt;Dictionary&amp;lt;string, IDataHandler&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;GetAssetIO&lt;/b&gt;(): &lt;font color=&quot;#0000cc&quot;&gt;AssetIO&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;HandleAsset&lt;/b&gt;(asset: &lt;font color=&quot;#0000cc&quot;&gt;AssetIO.AssetInfo&lt;/font&gt;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;HandleAssets&lt;/b&gt;(asset: &lt;font color=&quot;#0000cc&quot;&gt;IReadOnlyList&amp;lt;AssetIO.AssetInfo&amp;gt;&lt;/font&gt;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;CreateAtlasAssets&lt;/b&gt;(atlasName: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;, textureAssets: &lt;font color=&quot;#0000cc&quot;&gt;IReadOnlyList&amp;lt;TextureAsset&amp;gt;&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;AtlasAsset[]&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;+ &lt;/span&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas;&quot;&gt;CreateAtlasAssets&lt;/b&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;(atlasName: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;, textureAssets: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;IEnumerable&amp;lt;TextureAsset&amp;gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(63, 63, 63); font-family: Consolas;&quot;&gt;): &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Consolas; color: rgb(0, 0, 204);&quot;&gt;AtlasAsset[]&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;~ &lt;b&gt;FreezeDataAssets&lt;/b&gt;()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;~ &lt;b&gt;FinalizeAssets&lt;/b&gt;(makeAtlases: &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="-1080" width="680" height="550" as="geometry"/>
