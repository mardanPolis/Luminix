                <mxCell id="141" value="&lt;div&gt;&lt;b&gt;&lt;u&gt;sealed class AssetIO&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Description — &lt;font color=&quot;#0000cc&quot;&gt;AssetIO&lt;/font&gt; locates asset files on disk as &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt; and allows loading &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;&#39;s to typed assets, based on their extensions. It also provides a way to directly load typed assets from assemblies.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Properties —&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+ readonly &lt;u&gt;AssetInfo&lt;/u&gt; : struct&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ const ASSET_DIRECTORY: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ const ASSET_CACHE_DIRECTORY: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- static readonly textureExtensions: &lt;font color=&quot;#0000cc&quot;&gt;HashSet&amp;lt;string&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- static readonly audioExtensions: &lt;font color=&quot;#0000cc&quot;&gt;HashSet&amp;lt;string&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- static readonly dataExtensions: &lt;font color=&quot;#0000cc&quot;&gt;HashSet&amp;lt;string&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- static readonly xnbExtensions: &lt;font color=&quot;#0000cc&quot;&gt;HashSet&amp;lt;string&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;EnumerateAssetInfos&lt;/b&gt;(directory: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;, boot: &lt;font color=&quot;#0000cc&quot;&gt;bool?&lt;/font&gt; = null): &lt;font color=&quot;#0000cc&quot;&gt;IEnumerable&amp;lt;AssetInfo&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;GetAssetInfo&lt;/b&gt;(directory: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;, relativePath: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;TryGetAssetInfo&lt;/b&gt;(directory: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;, relativePath: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;, _assetInfo: out &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;IsTextureAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;IsAudioAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;IsXnbAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;IsDataAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;bool&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#0000cc&quot;&gt;//Sync&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Asset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadTextureAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;TextureAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadAudioAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;AudioAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadXnbAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;XnbAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadDataAsset&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;DataAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#0000cc&quot;&gt;//Assembly&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadAsset&lt;/b&gt;(assembly: &lt;font color=&quot;#0000cc&quot;&gt;Assembly&lt;/font&gt;, assetIdentifier: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Asset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadTextureAsset&lt;/b&gt;(assembly: &lt;font color=&quot;#0000cc&quot;&gt;Assembly&lt;/font&gt;, assetIdentifier: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;TextureAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadAudioAsset&lt;/b&gt;(assembly: &lt;font color=&quot;#0000cc&quot;&gt;Assembly&lt;/font&gt;, assetIdentifier: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;AudioAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadXnbAsset&lt;/b&gt;(assembly: &lt;font color=&quot;#0000cc&quot;&gt;Assembly&lt;/font&gt;, assetIdentifier: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;XnbAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ &lt;b&gt;LoadDataAsset&lt;/b&gt;(assembly: &lt;font color=&quot;#0000cc&quot;&gt;Assembly&lt;/font&gt;, assetIdentifier: &lt;font color=&quot;#0000cc&quot;&gt;string&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;DataAsset&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#0000cc&quot;&gt;//Async&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ async &lt;b&gt;LoadAssetAsync&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Task&amp;lt;Asset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ async &lt;b&gt;LoadTextureAssetAsync&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Task&amp;lt;TextureAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ async &lt;b&gt;LoadAudioAssetAsync&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Task&amp;lt;AudioAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ async &lt;b&gt;LoadXnbAssetAsync&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Task&amp;lt;XnbAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;+ async &lt;b&gt;LoadDataAssetAsync&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Task&amp;lt;DataAsset&amp;gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Consolas&quot;&gt;- &lt;b&gt;OpenStream&lt;/b&gt;(assetInfo: &lt;font color=&quot;#0000cc&quot;&gt;AssetInfo&lt;/font&gt;): &lt;font color=&quot;#0000cc&quot;&gt;Stream&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="-509" width="680" height="859" as="geometry"/>
                </mxCell>
                <mxCell id="143" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;readonly struct AssetInfo&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description —&amp;nbsp;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AssetInfo&lt;/font&gt;&lt;/code&gt; is a lightweight, immutable struct that describes an asset&#39;s location and basic metadata on disk, without opening or loading the asset itself.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;~ &lt;b style=&quot;&quot;&gt;AssetInfo&lt;/b&gt;(assetRoot: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, relativePath: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AssetInfo&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(63, 63, 63), rgb(237, 237, 237));&quot;&gt;Name&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(63, 63, 63), rgb(237, 237, 237));&quot;&gt;IsBoot&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;bool&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(63, 63, 63), rgb(237, 237, 237));&quot;&gt;Size&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;long&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;i style=&quot;&quot;&gt;AssetRoot&lt;/i&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;i&gt;Identifier&lt;/i&gt;:&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;i&gt;Extension&lt;/i&gt;:&lt;/font&gt;&lt;font color=&quot;#0000cc&quot;&gt;&amp;nbsp;string&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;&lt;font&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;FullPath&lt;/font&gt;&lt;/i&gt;&lt;font&gt;:&lt;/font&gt;&lt;/font&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="-509" width="340" height="359" as="geometry"/>
                </mxCell>
                <mxCell id="152" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Data Asset Format (JSON)&lt;br&gt;&lt;/h1&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;{&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; //Reserved Keys&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;DefType&quot;: &quot;&quot;,&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;DefName&quot;: &quot;&quot;,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; //Unreserved keys&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; //Example Def EntityType&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;Abstract&quot;: true,&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;Parent&quot;: null&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;EntitySystem&quot;: {&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;Type&quot;: &quot;EntitySystem&quot;,&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;Properties&quot;: {&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(211, 215, 222); background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;MaxHealth&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;100,&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;MaxStamina&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;50&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; },&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;Components&quot;: [&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; { &quot;Type&quot;: &quot;Stats&quot;, &quot;Health&quot;: 100, &quot;Stamina&quot;: 50 }&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&amp;nbsp; &amp;nbsp; ]&lt;/span&gt;&lt;br&gt;}&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Helvetica;" parent="1" vertex="1">
