                <mxCell id="143" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;readonly struct AssetInfo&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description —&amp;nbsp;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;AssetInfo&lt;/code&gt; is a lightweight, immutable struct that describes an asset&#39;s location and basic metadata on disk, without opening or loading the asset itself.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;~ &lt;b style=&quot;&quot;&gt;AssetInfo&lt;/b&gt;(assetRoot: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, relativePath: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AssetInfo&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Name&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: get &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;IsBoot&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: get &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;bool&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Size&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: get &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;long&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;i style=&quot;&quot;&gt;AssetRoot&lt;/i&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: get &lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;/font&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;i&gt;Identifier&lt;/i&gt;: get&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt; &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font face=&quot;Consolas&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ &lt;i&gt;Extension&lt;/i&gt;: get&lt;/font&gt;&lt;font color=&quot;#0000cc&quot;&gt; string&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;&lt;font&gt;+ &lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;FullPath&lt;/font&gt;&lt;/i&gt;&lt;font&gt;: &lt;/font&gt;&lt;font&gt;get&lt;/font&gt;&lt;/font&gt;&lt;font&gt; &lt;/font&gt;&lt;/font&