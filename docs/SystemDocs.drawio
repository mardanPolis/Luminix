                <mxCell id="159" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;AssetIO&lt;/h1&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;b&gt;AssetInfo&lt;/b&gt;:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;• AssetRoot: The absolute path to the asset.&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;• RelativePath:&lt;span style=&quot;background-color: transparent;&quot;&gt;The asset&#39;s path &lt;/span&gt;&lt;em style=&quot;background-color: transparent;&quot;&gt;relative to &lt;/em&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;RootPath&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;, its the path with the root path prefix and extension stripped off.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• Extension: The files extension, with the dot.&lt;br&gt;&lt;br&gt;&lt;b&gt;Extensions&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;• Texture&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&quot;.png&quot;; &quot;.jpg&quot;; &quot;.jpeg&quot;&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;• Audio&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&quot;.wav&quot;; &quot;.ogg&quot;; &quot;.mp3&quot;&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;• Data&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&quot;.json&quot;&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;• Xnb&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&quot;.xnb&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;Method Parameters – AssetInfo getters&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; color: rgb(63, 63, 63);&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;• directory&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent;&quot;&gt;: Identifies &lt;/span&gt;&lt;em style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;which module&lt;/em&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent;&quot;&gt; is being scanned, empty string for the base game, or &lt;/span&gt;&lt;code style=&quot;font-family: Helvetica; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63); background-color: rgba(255, 255, 255, 0.1);&quot; class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;Mods/&amp;lt;ModID&amp;gt;&lt;/code&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent;&quot;&gt; for a specific mod.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Helvetica; color: rgb(63, 63, 63);&quot;&gt;Example: &lt;code style=&quot;font-family: Helvetica; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63); background-color: rgba(255, 255, 255, 0.1);&quot; class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&quot;&quot;&lt;/code&gt; or &lt;code style=&quot;font-family: Helvetica; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63); background-color: rgba(255, 255, 255, 0.1);&quot; class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&quot;Mods/GoblinExpansionPack&quot;&lt;/code&gt;&lt;br style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;• boot: &lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;Represents if the method should return boot, non–boot or both types of assets, by checking whether RelativePath starts with &#39;Boot&#39;. &lt;br&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(63, 63, 63);&quot;&gt;Possible opptions:&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;i style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;null&lt;/i&gt;&amp;nbsp; &amp;nbsp;– both boot and non–boot assets&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;i style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;false&lt;/i&gt; – only non–boot assets&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;true&amp;nbsp; – only boot assets&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="-130" width="340" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="161" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Asset Loading Pipeline&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="3375" y="-1090" width="330" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="162" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;abstract class Asset&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — abstract base class for every loadable game asset. It defines the identity and naming properties (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;Name&lt;/code&gt;, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;Identifier&lt;/code&gt;) shared by all concrete asset types (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;TextureAsset&lt;/font&gt;&lt;/code&gt;, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AtlasAsset&lt;/font&gt;&lt;/code&gt;, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AudioAsset&lt;/font&gt;&lt;/code&gt;, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;XnbAsset&lt;/font&gt;&lt;/code&gt;, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;DataAsset&lt;/font&gt;&lt;/code&gt;).&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;~&amp;nbsp;&lt;b&gt;Asset&lt;/b&gt;(identifier: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, name : &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Asset&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(63, 63, 63), rgb(237, 237, 237));&quot;&gt;Name&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Identifier&lt;/i&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2460" y="-1080" width="340" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="164" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;class TextureAsset : Asset&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — represents a single fully-loaded 2D image, along with its pixel dimensions and raw color data.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;~ &lt;b&gt;TextureAsset&lt;/b&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;identifier: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, name : &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, colors : &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Color[]&lt;/font&gt;, size: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Vector2&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;TextureAsset&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(63, 63, 63), rgb(237, 237, 237));&quot;&gt;Colors&lt;/font&gt;&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Color[]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;i&gt;Size&lt;/i&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Vector2&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2820" y="-1080" width="340" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="165" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;class AtlasAsset : Asset&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — represents a texture atlas: one loaded image containing multiple packed sub-images, exposed as a set of named &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Region&lt;/font&gt;&#39;s&lt;/code&gt;so individual sprites can be looked up without re-loading the source texture.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;~ &lt;b&gt;AtlasAsset&lt;/b&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;name : &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, colors: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;Color[]&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, size: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Vector2&lt;/font&gt;, &lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;regions:&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt; &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Region[]&lt;/font&gt;&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AtlasAsset&lt;/font&gt;&lt;br&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Colors&lt;/i&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;Color[]&lt;/font&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;i style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Size&lt;/i&gt;&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;Vector2&lt;/font&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;+ get&amp;nbsp;&lt;i style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Regions&lt;/i&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;Region[]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;i&gt;ToString&lt;/i&gt;:&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="2460" y="-730" width="340" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="166" value="&lt;u style=&quot;font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;class AudioAsset : Asset&lt;/font&gt;&lt;/u&gt;&lt;br&gt;&lt;br&gt;Description — represents a short sound effect that is fully decoded and loaded into memory, ready for immediate, low-latency playback.&lt;br&gt;&lt;br&gt;Properties —&amp;nbsp;&lt;br&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Consolas&quot; face=&quot;Consolas&quot;&gt;~ &lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;AudioAsset&lt;/font&gt;&lt;/b&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;identifier: &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;, name : &lt;/span&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 204);&quot;&gt;string&lt;/font&gt;, soundEffect: &lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;SoundEffect&lt;/font&gt;) :&amp;nbsp;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;AudioAsset&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;+ get&amp;nbsp;&lt;/font&gt;&lt;i style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;SoundEffect&lt;/i&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;:&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;SoundEffect&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" parent="1" vertex="1">
