<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
    <MonoGameContentBuilderExtraArgs>/outputDir:bin/Assets /intermediateDir:obj/Assets</MonoGameContentBuilderExtraArgs>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="RectpackSharp" Version="1.1.*" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Assets.mgcb">
      <ContentFolder>Assets</ContentFolder>
      <OutputFolder>.</OutputFolder>
    </MonoGameContentReference>
  </ItemGroup>

  <Target Name="BuildContent" BeforeTargets="Build">
    <Exec Command="dotnet mgcb /@:&quot;$(MSBuildProjectDirectory)/Assets.mgcb&quot; /platform:DesktopGL /outputDir:&quot;$(MSBuildProjectDirectory)/bin/$(Configuration)/net10.0/Assets&quot; /intermediateDir:&quot;$(MSBuildProjectDirectory)/obj/$(Configuration)/net10.0/Assets&quot; /workingDir:&quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
</Project>