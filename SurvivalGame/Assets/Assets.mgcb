
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)/$(Configuration)/Assets
/intermediateDir:obj/$(Platform)/Assets
/platform:DesktopGL
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Boot/Fonts/IBMPlexMono-Bold.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Boot/Fonts/IBMPlexMono-Bold.spritefont

#begin Boot/Fonts/IBMPlexMono-Medium.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Boot/Fonts/IBMPlexMono-Medium.spritefont

#begin Boot/Fonts/IBMPlexMono-Regular.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Boot/Fonts/IBMPlexMono-Regular.spritefont

#begin Boot/Shaders/TileShader.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:Boot/Shaders/TileShader.fx

