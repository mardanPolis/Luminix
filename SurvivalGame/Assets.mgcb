
#----------------------------- Global Properties ----------------------------#

/outputDir:build/bin/Debug/net10.0
/intermediateDir:build/obj/Debug/net10.0
/platform:DesktopGL
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Assets/Boot/Fonts/IBMPlexMono-Bold.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Assets/Boot/Fonts/IBMPlexMono-Bold.spritefont

#begin Assets/Boot/Fonts/IBMPlexMono-Medium.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Assets/Boot/Fonts/IBMPlexMono-Medium.spritefont

#begin Assets/Boot/Fonts/IBMPlexMono-Regular.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Assets/Boot/Fonts/IBMPlexMono-Regular.spritefont

#begin Assets/Boot/Shaders/TileShader.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:Assets/Boot/Shaders/TileShader.fx

#begin Assets/Textures/Diamond.png
/copy:Assets/Textures/Diamond.png

#begin Assets/Textures/Square.png
/copy:Assets/Textures/Square.png

#begin Assets/Textures/Triangle.png
/copy:Assets/Textures/Triangle.png

