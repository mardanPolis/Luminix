<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>

    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Version>1.0.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Automated Miniaudio Fetch, Wrapper Generation, and Compilation Pipeline -->  
  <Target Name="BuildMiniaudio" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)/native/miniaudio</NativeDir>
      <NativeOutDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)</NativeOutDir>
    </PropertyGroup>

    <MakeDir Directories="$(NativeDir);$(NativeDir)/fetched;$(NativeOutDir)" />

    <DownloadFile 
      SourceUrl="https://raw.githubusercontent.com/mackron/miniaudio/master/miniaudio.h" 
      DestinationFolder="$(NativeDir)/fetched"
      Condition="!Exists('$(NativeDir)/fetched/miniaudio.h')" />

    <Exec Command="zig cc -target x86_64-windows-gnu -shared -O2 -o $(IntermediateOutputPath)miniaudio.dll $(NativeDir)/miniaudio.c" 
          Condition="!Exists('$(IntermediateOutputPath)miniaudio.dll')" />

    <Exec Command="zig cc -target x86_64-linux-gnu -shared -fPIC -O2 -o $(IntermediateOutputPath)libminiaudio.so $(NativeDir)/miniaudio.c -lpthread -lm -ldl" 
          Condition="!Exists('$(IntermediateOutputPath)libminiaudio.so')" />

    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)libminiaudio.so">
        <LogicalName>libminiaudio.so</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(IntermediateOutputPath)miniaudio.dll">
        <LogicalName>miniaudio.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets/Built-In/**/*.xnb">
      <LogicalName>$([System.String]::Copy('%(Identity)').Replace('\', '.').Replace('/', '.'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="../MonoGame/MonoGame.Framework/MonoGame.Framework.DesktopGL.csproj" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="RectpackSharp" Version="1.1.*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("dd/MM/yyyy"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>